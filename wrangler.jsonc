// Website https://gcetools.jordilopezr.com, served as a Cloudflare Worker with static assets.
// Deploy: `npx wrangler deploy` from the repo root (or Workers Builds connected to this repo).
// The custom domain route creates the DNS record and certificate, provided
// jordilopezr.com is a zone in the same Cloudflare account.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gcetools-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site/public"
  },
  "routes": [
    { "pattern": "gcetools.jordilopezr.com", "custom_domain": true }
  ]
}
