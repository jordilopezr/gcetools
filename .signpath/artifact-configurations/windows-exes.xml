<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "windows-exes": first round, the
     executables (the NSIS installer is rebuilt afterwards with the signed
     gcetools.exe inside). Paste it in SignPath > Project > Artifact
     configurations. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="gcetools.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="gcetools-cli.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
